root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# SSMS çıktısını taklit eden örnek UTF-16 ve CRLF'tir · Imitates SSMS output: UTF-16 with CRLF
[samples/banka/*.sql]
charset = unset
end_of_line = unset
