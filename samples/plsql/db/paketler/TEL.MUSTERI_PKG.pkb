CREATE OR REPLACE EDITIONABLE PACKAGE BODY "TEL"."MUSTERI_PKG" AS
  FUNCTION KAYDET(P_AD IN VARCHAR2, P_TCKN IN VARCHAR2, P_TIP IN CHAR) RETURN NUMBER IS
    V_ID NUMBER;
    -- iç fonksiyon: yalnızca KAYDET kullanır
    FUNCTION TCKN_GECERLI(P IN VARCHAR2) RETURN BOOLEAN IS
    BEGIN
      RETURN REGEXP_LIKE(P, '^[1-9][0-9]{10}$');
    END TCKN_GECERLI;
  BEGIN
    IF P_TIP = 'B' AND NOT TCKN_GECERLI(P_TCKN) THEN
      HATA_PKG.FIRLAT('MUSTERI', 'Geçersiz TCKN');
    END IF;
    INSERT INTO TEL.MUSTERI (MUSTERI_ID, AD_SOYAD, TCKN, MUSTERI_TIPI, KAYIT_TAR)
    VALUES (TEL.SEQ_MUSTERI.NEXTVAL, P_AD, P_TCKN, P_TIP, SYSDATE)
    RETURNING MUSTERI_ID INTO V_ID;
    RETURN V_ID;
  END KAYDET;

  -- mükerrer müşteri: aboneler kalan kayda taşınır
  PROCEDURE BIRLESTIR(P_KALAN_ID IN NUMBER, P_SILINEN_ID IN NUMBER) IS
  BEGIN
    UPDATE TEL.ABONE SET MUSTERI_ID = P_KALAN_ID WHERE MUSTERI_ID = P_SILINEN_ID;
    DELETE FROM TEL.MUSTERI WHERE MUSTERI_ID = P_SILINEN_ID;
    LOG_PKG.YAZ('MUSTERI', P_SILINEN_ID || ' -> ' || P_KALAN_ID);
  END BIRLESTIR;
END MUSTERI_PKG;
/
