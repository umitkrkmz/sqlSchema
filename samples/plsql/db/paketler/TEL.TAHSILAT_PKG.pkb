CREATE OR REPLACE EDITIONABLE PACKAGE BODY "TEL"."TAHSILAT_PKG" AS
  PROCEDURE ODEME_AL(P_ABONE_ID IN NUMBER, P_TUTAR IN NUMBER, P_KANAL IN VARCHAR2) IS
  BEGIN
    INSERT INTO TEL.ODEME (ODEME_ID, ABONE_ID, TUTAR, ODEME_TAR, KANAL)
    VALUES (TEL.SEQ_ODEME.NEXTVAL, P_ABONE_ID, P_TUTAR, SYSDATE, P_KANAL);
    -- mahsup TRG_ODEME_AI tetikleyicisinde
  END ODEME_AL;

  -- ödemeyi en eski açık faturalardan başlayarak dağıtır
  PROCEDURE MAHSUP(P_ODEME_ID IN NUMBER) IS
    V_KALAN NUMBER;
    V_ABONE NUMBER;
  BEGIN
    SELECT TUTAR, ABONE_ID INTO V_KALAN, V_ABONE FROM TEL.ODEME WHERE ODEME_ID = P_ODEME_ID;
    FOR F IN (SELECT FATURA_ID, TUTAR FROM TEL.FATURA WHERE ABONE_ID = V_ABONE AND DURUM = 'A' ORDER BY SON_ODEME_TAR) LOOP
      EXIT WHEN V_KALAN <= 0;
      INSERT INTO TEL.ODEME_MAHSUP (ODEME_ID, FATURA_ID, TUTAR) VALUES (P_ODEME_ID, F.FATURA_ID, LEAST(V_KALAN, F.TUTAR));
      IF V_KALAN >= F.TUTAR THEN
        UPDATE TEL.FATURA SET DURUM = 'O' WHERE FATURA_ID = F.FATURA_ID;
      END IF;
      V_KALAN := V_KALAN - F.TUTAR;
    END LOOP;
  END MAHSUP;

  PROCEDURE MAHSUP_GERI_AL(P_FATURA_ID IN NUMBER) IS
  BEGIN
    DELETE FROM TEL.ODEME_MAHSUP WHERE FATURA_ID = P_FATURA_ID;
  END MAHSUP_GERI_AL;

  FUNCTION BORC(P_ABONE_ID IN NUMBER) RETURN NUMBER IS
    V NUMBER;
  BEGIN
    SELECT NVL(SUM(F.TUTAR), 0) - NVL(SUM(M.TUTAR), 0) INTO V
      FROM TEL.FATURA F LEFT JOIN TEL.ODEME_MAHSUP M ON M.FATURA_ID = F.FATURA_ID
     WHERE F.ABONE_ID = P_ABONE_ID AND F.DURUM <> 'I';
    RETURN V;
  END BORC;
END TAHSILAT_PKG;
/
