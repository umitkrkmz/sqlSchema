CREATE OR REPLACE EDITIONABLE PACKAGE BODY "ORTAK"."HATA_PKG" AS
  -- son hatayı kaydeder; çağıran RAISE ile yeniden fırlatır
  PROCEDURE KAYDET(P_MODUL IN VARCHAR2) IS
  BEGIN
    LOG_PKG.HATA_YAZ(P_MODUL, SQLCODE, SQLERRM);
  END KAYDET;

  PROCEDURE FIRLAT(P_MODUL IN VARCHAR2, P_MESAJ IN VARCHAR2) IS
  BEGIN
    LOG_PKG.YAZ(P_MODUL, P_MESAJ, 'E');
    RAISE_APPLICATION_ERROR(-20001, P_MODUL || ': ' || P_MESAJ);
  END FIRLAT;
END HATA_PKG;
/
