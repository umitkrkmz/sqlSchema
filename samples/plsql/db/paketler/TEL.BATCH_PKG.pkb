CREATE OR REPLACE EDITIONABLE PACKAGE BODY "TEL"."BATCH_PKG" AS
  -- çalışacak işler ORTAK.IS_TANIMI tablosunda: paket ve yordam adı metin olarak gelir
  PROCEDURE ISI_CALISTIR(P_PAKET IN VARCHAR2, P_YORDAM IN VARCHAR2) IS
  BEGIN
    LOG_PKG.YAZ('BATCH', P_PAKET || '.' || P_YORDAM || ' başladı');
    EXECUTE IMMEDIATE 'BEGIN ' || P_PAKET || '.' || P_YORDAM || '; END;';
  EXCEPTION
    WHEN OTHERS THEN
      HATA_PKG.KAYDET('BATCH');
  END ISI_CALISTIR;

  PROCEDURE GECE_ISI IS
    V_DONEM VARCHAR2(6) := ORTAK.TARIH_PKG.DONEM(ADD_MONTHS(SYSDATE, -1));
  BEGIN
    CDR_PKG.OZETLE(V_DONEM);
    IF TO_CHAR(SYSDATE, 'DD') = ORTAK.PARAM_PKG.DEGER('FATURA_GUNU') THEN
      FATURA_PKG.DONEM_KES(V_DONEM);
    END IF;
    FOR R IN (SELECT PAKET_ADI, YORDAM_ADI FROM ORTAK.IS_TANIMI WHERE AKTIF_MI = 'E' ORDER BY SIRA) LOOP
      ISI_CALISTIR(R.PAKET_ADI, R.YORDAM_ADI);
    END LOOP;
    ARSIVLE;
    LOG_PKG.TEMIZLE(ORTAK.PARAM_PKG.SAYI('LOG_SAKLAMA_GUN'));
  END GECE_ISI;

  -- hangi tablonun arşivleneceği ORTAK.ARSIV_TANIM'dan okunur; tablo adları metin
  PROCEDURE ARSIVLE IS
    V_SQL VARCHAR2(4000);
  BEGIN
    FOR A IN (SELECT TABLO_ADI, ARSIV_TABLO_ADI, TARIH_KOLONU, SAKLAMA_GUN FROM ORTAK.ARSIV_TANIM) LOOP
      V_SQL := 'INSERT INTO ' || A.ARSIV_TABLO_ADI || ' SELECT * FROM ' || A.TABLO_ADI
            || ' WHERE ' || A.TARIH_KOLONU || ' < SYSDATE - :1';
      EXECUTE IMMEDIATE V_SQL USING A.SAKLAMA_GUN;
      EXECUTE IMMEDIATE 'DELETE FROM ' || A.TABLO_ADI || ' WHERE ' || A.TARIH_KOLONU || ' < SYSDATE - :1' USING A.SAKLAMA_GUN;
      COMMIT;
    END LOOP;
  END ARSIVLE;
END BATCH_PKG;
/
