CREATE OR REPLACE EDITIONABLE PACKAGE BODY "TEL"."HAT_PKG" AS
  -- havuzdan ilk boş numarayı ayırır
  FUNCTION NUMARA_AYIR(P_ABONE_ID IN NUMBER) RETURN VARCHAR2 IS
    V_MSISDN VARCHAR2(15);
  BEGIN
    SELECT MSISDN INTO V_MSISDN FROM TEL.NUMARA_HAVUZU
     WHERE DURUM = 'B' AND ROWNUM = 1
       FOR UPDATE SKIP LOCKED;
    UPDATE TEL.NUMARA_HAVUZU SET DURUM = 'R', REZERVE_ABONE_ID = P_ABONE_ID WHERE MSISDN = V_MSISDN;
    RETURN V_MSISDN;
  END NUMARA_AYIR;

  FUNCTION HAT_AC(P_ABONE_ID IN NUMBER) RETURN NUMBER IS
    V_ID NUMBER;
  BEGIN
    INSERT INTO TEL.HAT (HAT_ID, ABONE_ID, MSISDN, DURUM, ACILIS_TAR)
    VALUES (TEL.SEQ_HAT.NEXTVAL, P_ABONE_ID, NUMARA_AYIR(P_ABONE_ID), 'A', SYSDATE)
    RETURNING HAT_ID INTO V_ID;
    LOG_PKG.YAZ('HAT', 'Hat açıldı ' || V_ID);
    RETURN V_ID;
  END HAT_AC;

  PROCEDURE HAT_KAPAT(P_HAT_ID IN NUMBER) IS
  BEGIN
    UPDATE TEL.HAT SET DURUM = 'K', KAPANIS_TAR = SYSDATE WHERE HAT_ID = P_HAT_ID;
    UPDATE TEL.NUMARA_HAVUZU SET DURUM = 'B', REZERVE_ABONE_ID = NULL
     WHERE MSISDN = (SELECT MSISDN FROM TEL.HAT WHERE HAT_ID = P_HAT_ID);
  END HAT_KAPAT;

  PROCEDURE TASIMA_BASLAT(P_HAT_ID IN NUMBER, P_OPERATOR IN VARCHAR2) IS
  BEGIN
    INSERT INTO TEL.TASIMA_TALEBI (TALEP_ID, HAT_ID, KARSI_OPERATOR, DURUM, TALEP_TAR)
    VALUES (TEL.SEQ_TASIMA.NEXTVAL, P_HAT_ID, P_OPERATOR, 'B', SYSDATE);
    -- karşı operatöre bildirim web servisle
    BILDIRIM_PKG.SERVIS_CAGIR('TASIMA', P_HAT_ID);
  END TASIMA_BASLAT;
END HAT_PKG;
/
