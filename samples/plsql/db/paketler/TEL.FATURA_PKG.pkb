CREATE OR REPLACE EDITIONABLE PACKAGE BODY "TEL"."FATURA_PKG" AS
  CURSOR C_FATURALANACAK IS
    SELECT ABONE_ID, TARIFE_ID FROM TEL.ABONE WHERE DURUM = 'A';

  PROCEDURE KALEM_EKLE(P_FATURA_ID IN NUMBER, P_NO IN NUMBER, P_ACIKLAMA IN VARCHAR2, P_TUTAR IN NUMBER) IS
  BEGIN
    INSERT INTO TEL.FATURA_KALEM (FATURA_ID, KALEM_NO, ACIKLAMA, TUTAR)
    VALUES (P_FATURA_ID, P_NO, P_ACIKLAMA, P_TUTAR);
  END KALEM_EKLE;

  -- kullanım ücreti aylık CDR tablosundan: TEL.CDR_YYYYMM (tablo adı dönemden kurulur)
  FUNCTION KULLANIM(P_ABONE_ID IN NUMBER, P_DONEM IN VARCHAR2) RETURN NUMBER IS
    V_SQL   VARCHAR2(1000);
    V_TUTAR NUMBER;
  BEGIN
    V_SQL := 'SELECT NVL(SUM(C.UCRET), 0) FROM TEL.CDR_' || P_DONEM || ' C JOIN TEL.HAT H ON H.MSISDN = C.MSISDN'
          || ' WHERE H.ABONE_ID = :1';
    EXECUTE IMMEDIATE V_SQL INTO V_TUTAR USING P_ABONE_ID;
    RETURN V_TUTAR;
  END KULLANIM;

  FUNCTION FATURA_KES(P_ABONE_ID IN NUMBER, P_DONEM IN VARCHAR2) RETURN NUMBER IS
    V_ID     NUMBER;
    V_TARIFE NUMBER;
    V_AYLIK  NUMBER;
    V_KULLAN NUMBER;
    V_ORAN   NUMBER;
  BEGIN
    SELECT TARIFE_ID INTO V_TARIFE FROM TEL.ABONE WHERE ABONE_ID = P_ABONE_ID;
    V_AYLIK  := TARIFE_PKG.AYLIK_UCRET(V_TARIFE, ORTAK.TARIH_PKG.AY_BASI(P_DONEM));
    V_KULLAN := KULLANIM(P_ABONE_ID, P_DONEM);
    V_ORAN   := KAMPANYA_PKG.INDIRIM(P_ABONE_ID, P_DONEM);
    INSERT INTO TEL.FATURA (FATURA_ID, ABONE_ID, DONEM, TUTAR, DURUM, SON_ODEME_TAR)
    VALUES (TEL.SEQ_FATURA.NEXTVAL, P_ABONE_ID, P_DONEM, (V_AYLIK + V_KULLAN) * (1 - V_ORAN / 100), 'A',
            ORTAK.TARIH_PKG.AY_BASI(P_DONEM) + ORTAK.PARAM_PKG.SAYI('SON_ODEME_GUN'))
    RETURNING FATURA_ID INTO V_ID;
    KALEM_EKLE(V_ID, 1, 'Aylık ücret', V_AYLIK);
    KALEM_EKLE(V_ID, 2, 'Kullanım', V_KULLAN);
    RETURN V_ID;
  END FATURA_KES;

  PROCEDURE DONEM_KES(P_DONEM IN VARCHAR2) IS
    V_ID NUMBER;
  BEGIN
    FOR R IN C_FATURALANACAK LOOP
      BEGIN
        V_ID := FATURA_KES(R.ABONE_ID, P_DONEM);
      EXCEPTION
        WHEN OTHERS THEN
          HATA_PKG.KAYDET('FATURA');
      END;
    END LOOP;
    LOG_PKG.YAZ('FATURA', P_DONEM || ' dönemi kesildi');
  END DONEM_KES;

  PROCEDURE IPTAL(P_FATURA_ID IN NUMBER) IS
  BEGIN
    DELETE FROM TEL.FATURA_KALEM WHERE FATURA_ID = P_FATURA_ID;
    UPDATE TEL.FATURA SET DURUM = 'I' WHERE FATURA_ID = P_FATURA_ID;
    TAHSILAT_PKG.MAHSUP_GERI_AL(P_FATURA_ID);
  END IPTAL;
END FATURA_PKG;
/
