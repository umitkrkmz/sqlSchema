CREATE OR REPLACE EDITIONABLE PACKAGE BODY "TEL"."RAPOR_PKG" AS
  -- filtreler isteğe bağlı: WHERE koşulu metin olarak kurulur
  FUNCTION ABONE_LISTESI(P_DURUM IN CHAR, P_TARIFE_ID IN NUMBER) RETURN T_IMLEC IS
    V_IMLEC T_IMLEC;
    V_SQL   VARCHAR2(2000) := 'SELECT A.ABONE_ID, M.AD_SOYAD, T.TARIFE_ADI FROM TEL.ABONE A'
                           || ' JOIN TEL.MUSTERI M ON M.MUSTERI_ID = A.MUSTERI_ID'
                           || ' JOIN TEL.TARIFE T ON T.TARIFE_ID = A.TARIFE_ID WHERE 1 = 1';
  BEGIN
    IF P_DURUM IS NOT NULL THEN
      V_SQL := V_SQL || ' AND A.DURUM = ''' || P_DURUM || '''';
    END IF;
    IF P_TARIFE_ID IS NOT NULL THEN
      V_SQL := V_SQL || ' AND A.TARIFE_ID = ' || P_TARIFE_ID;
    END IF;
    OPEN V_IMLEC FOR V_SQL;
    RETURN V_IMLEC;
  END ABONE_LISTESI;

  -- tablo adı parametreden: DBMS_SQL ile
  FUNCTION SATIR_SAYISI(P_TABLO IN VARCHAR2) RETURN NUMBER IS
    V_IMLEC INTEGER := DBMS_SQL.OPEN_CURSOR;
    V_SAYI  NUMBER;
    V_SONUC INTEGER;
  BEGIN
    DBMS_SQL.PARSE(V_IMLEC, 'SELECT COUNT(*) FROM ' || DBMS_ASSERT.SQL_OBJECT_NAME(P_TABLO), DBMS_SQL.NATIVE);
    DBMS_SQL.DEFINE_COLUMN(V_IMLEC, 1, V_SAYI);
    V_SONUC := DBMS_SQL.EXECUTE_AND_FETCH(V_IMLEC);
    DBMS_SQL.COLUMN_VALUE(V_IMLEC, 1, V_SAYI);
    DBMS_SQL.CLOSE_CURSOR(V_IMLEC);
    RETURN V_SAYI;
  END SATIR_SAYISI;
END RAPOR_PKG;
/
