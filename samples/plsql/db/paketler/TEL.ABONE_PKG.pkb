CREATE OR REPLACE EDITIONABLE PACKAGE BODY "TEL"."ABONE_PKG" AS
  -- paket dışına açılmayan doğrulama
  PROCEDURE DOGRULA(P_MUSTERI_ID IN NUMBER) IS
    V_SAY NUMBER;
  BEGIN
    SELECT COUNT(*) INTO V_SAY FROM TEL.MUSTERI WHERE MUSTERI_ID = P_MUSTERI_ID;
    IF V_SAY = 0 THEN
      HATA_PKG.FIRLAT('ABONE', 'Müşteri yok: ' || P_MUSTERI_ID);
    END IF;
  END DOGRULA;

  FUNCTION YENI_ABONE(P_MUSTERI_ID IN NUMBER, P_TARIFE_ID IN NUMBER) RETURN NUMBER IS
    V_ID NUMBER;
  BEGIN
    DOGRULA(P_MUSTERI_ID);
    IF TARIFE_PKG.AKTIF_MI(P_TARIFE_ID) = 'H' THEN
      HATA_PKG.FIRLAT('ABONE', 'Tarife satışta değil');
    END IF;
    INSERT INTO TEL.ABONE (ABONE_ID, MUSTERI_ID, TARIFE_ID, DURUM, BASLANGIC_TAR)
    VALUES (TEL.SEQ_ABONE.NEXTVAL, P_MUSTERI_ID, P_TARIFE_ID, 'A', TRUNC(SYSDATE))
    RETURNING ABONE_ID INTO V_ID;
    LOG_PKG.YAZ('ABONE', 'Yeni abone ' || V_ID);
    RETURN V_ID;
  END YENI_ABONE;

  PROCEDURE DURUM_DEGISTIR(P_ABONE_ID IN NUMBER, P_DURUM IN CHAR) IS
  BEGIN
    UPDATE TEL.ABONE SET DURUM = P_DURUM WHERE ABONE_ID = P_ABONE_ID;
    IF SQL%ROWCOUNT = 0 THEN
      HATA_PKG.FIRLAT('ABONE', 'Abone bulunamadı');
    END IF;
  END DURUM_DEGISTIR;

  FUNCTION BUL(P_MSISDN IN VARCHAR2) RETURN NUMBER IS
    V_ID NUMBER;
  BEGIN
    SELECT A.ABONE_ID INTO V_ID
      FROM TEL.ABONE A JOIN TEL.HAT H ON H.ABONE_ID = A.ABONE_ID
     WHERE H.MSISDN = P_MSISDN AND H.DURUM = 'A';
    RETURN V_ID;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      RETURN NULL;
  END BUL;

  PROCEDURE KAPAT(P_ABONE_ID IN NUMBER) IS
  BEGIN
    FOR R IN (SELECT HAT_ID FROM TEL.HAT WHERE ABONE_ID = P_ABONE_ID AND DURUM = 'A') LOOP
      HAT_PKG.HAT_KAPAT(R.HAT_ID);
    END LOOP;
    DURUM_DEGISTIR(P_ABONE_ID, 'K');
    UPDATE TEL.ABONE SET BITIS_TAR = TRUNC(SYSDATE) WHERE ABONE_ID = P_ABONE_ID;
    BILDIRIM_PKG.KUYRUGA_EKLE(P_ABONE_ID, 'SMS', 'Aboneliğiniz kapatıldı.');
  EXCEPTION
    WHEN OTHERS THEN
      HATA_PKG.KAYDET('ABONE');
      RAISE;
  END KAPAT;
END ABONE_PKG;
/
