CREATE OR REPLACE EDITIONABLE PACKAGE "ORTAK"."LOG_PKG" AS
  -- Bütün paketlerin kullandığı günlük paketi
  PROCEDURE YAZ(P_MODUL IN VARCHAR2, P_MESAJ IN VARCHAR2);
  PROCEDURE YAZ(P_MODUL IN VARCHAR2, P_MESAJ IN VARCHAR2, P_SEVIYE IN CHAR);
  PROCEDURE HATA_YAZ(P_MODUL IN VARCHAR2, P_KOD IN NUMBER, P_MESAJ IN VARCHAR2);
  PROCEDURE TEMIZLE(P_GUN IN NUMBER DEFAULT 90);
END LOG_PKG;
/
