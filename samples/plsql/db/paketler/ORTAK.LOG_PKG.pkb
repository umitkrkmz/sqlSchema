CREATE OR REPLACE EDITIONABLE PACKAGE BODY "ORTAK"."LOG_PKG" AS
  PROCEDURE YAZ(P_MODUL IN VARCHAR2, P_MESAJ IN VARCHAR2) IS
  BEGIN
    YAZ(P_MODUL, P_MESAJ, 'I');
  END YAZ;

  -- otonom işlem: çağıran geri alsa da günlük kalır
  PROCEDURE YAZ(P_MODUL IN VARCHAR2, P_MESAJ IN VARCHAR2, P_SEVIYE IN CHAR) IS
    PRAGMA AUTONOMOUS_TRANSACTION;
  BEGIN
    INSERT INTO ORTAK.LOG_KAYIT (LOG_ID, MODUL, MESAJ, SEVIYE, KAYIT_ZAMANI)
    VALUES (ORTAK.SEQ_LOG.NEXTVAL, P_MODUL, SUBSTR(P_MESAJ, 1, 4000), P_SEVIYE, SYSTIMESTAMP);
    COMMIT;
  END YAZ;

  PROCEDURE HATA_YAZ(P_MODUL IN VARCHAR2, P_KOD IN NUMBER, P_MESAJ IN VARCHAR2) IS
    PRAGMA AUTONOMOUS_TRANSACTION;
  BEGIN
    INSERT INTO ORTAK.HATA_KAYIT (HATA_ID, MODUL, HATA_KODU, HATA_MESAJI, YIGIN, KAYIT_ZAMANI)
    VALUES (ORTAK.SEQ_HATA.NEXTVAL, P_MODUL, P_KOD, P_MESAJ, DBMS_UTILITY.FORMAT_ERROR_BACKTRACE, SYSTIMESTAMP);
    COMMIT;
  END HATA_YAZ;

  -- eski bölümler adla düşürülür: LOG_KAYIT tablosunun P_2024_09 gibi aylık bölümleri
  PROCEDURE TEMIZLE(P_GUN IN NUMBER DEFAULT 90) IS
    V_BOLUM VARCHAR2(30);
  BEGIN
    V_BOLUM := 'P_' || TO_CHAR(ADD_MONTHS(SYSDATE, -CEIL(P_GUN / 30)), 'YYYY_MM');
    EXECUTE IMMEDIATE 'ALTER TABLE ORTAK.LOG_KAYIT DROP PARTITION ' || V_BOLUM;
    YAZ('LOG', 'Bölüm silindi: ' || V_BOLUM);
  EXCEPTION
    WHEN OTHERS THEN
      HATA_YAZ('LOG', SQLCODE, SQLERRM);
  END TEMIZLE;
END LOG_PKG;
/
