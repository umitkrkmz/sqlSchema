CREATE OR REPLACE EDITIONABLE PACKAGE BODY "ORTAK"."TARIH_PKG" AS
  -- tabloya dokunmayan yardımcılar
  FUNCTION DONEM(P_TARIH IN DATE) RETURN VARCHAR2 IS
  BEGIN
    RETURN TO_CHAR(P_TARIH, 'YYYYMM');
  END DONEM;

  FUNCTION AY_BASI(P_DONEM IN VARCHAR2) RETURN DATE IS
  BEGIN
    RETURN TO_DATE(P_DONEM || '01', 'YYYYMMDD');
  END AY_BASI;

  FUNCTION IS_GUNU_MU(P_TARIH IN DATE) RETURN BOOLEAN IS
  BEGIN
    RETURN TO_CHAR(P_TARIH, 'D', 'NLS_DATE_LANGUAGE=TURKISH') NOT IN ('6', '7');
  END IS_GUNU_MU;
END TARIH_PKG;
/
