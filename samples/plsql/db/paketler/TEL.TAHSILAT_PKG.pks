CREATE OR REPLACE EDITIONABLE PACKAGE "TEL"."TAHSILAT_PKG" AS
  PROCEDURE ODEME_AL(P_ABONE_ID IN NUMBER, P_TUTAR IN NUMBER, P_KANAL IN VARCHAR2);
  PROCEDURE MAHSUP(P_ODEME_ID IN NUMBER);
  PROCEDURE MAHSUP_GERI_AL(P_FATURA_ID IN NUMBER);
  FUNCTION BORC(P_ABONE_ID IN NUMBER) RETURN NUMBER;
END TAHSILAT_PKG;
/
