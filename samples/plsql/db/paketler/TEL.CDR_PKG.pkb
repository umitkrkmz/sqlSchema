CREATE OR REPLACE EDITIONABLE PACKAGE BODY "TEL"."CDR_PKG" AS
  -- her ay yeni bir CDR tablosu açılır (TEL.CDR_YYYYMM); bu yüzden kodun çoğu dinamik SQL
  PROCEDURE AY_TABLOSU_AC(P_DONEM IN VARCHAR2) IS
  BEGIN
    EXECUTE IMMEDIATE 'CREATE TABLE TEL.CDR_' || P_DONEM || ' AS SELECT * FROM TEL.CDR_202410 WHERE 1 = 0';
    LOG_PKG.YAZ('CDR', 'Tablo açıldı: CDR_' || P_DONEM);
  END AY_TABLOSU_AC;

  PROCEDURE YUKLE(P_DOSYA IN VARCHAR2) IS
    V_DONEM VARCHAR2(6);
    V_SQL   VARCHAR2(2000);
  BEGIN
    SELECT TO_CHAR(MIN(ARAMA_ZAMANI), 'YYYYMM') INTO V_DONEM FROM TEL.CDR_YUKLEME WHERE DOSYA_ADI = P_DOSYA;
    V_SQL := 'INSERT INTO TEL.CDR_' || V_DONEM || ' (MSISDN, ARAMA_ZAMANI, SURE_SN, UCRET)'
          || ' SELECT Y.MSISDN, Y.ARAMA_ZAMANI, Y.SURE_SN, NULL FROM TEL.CDR_YUKLEME Y WHERE Y.DOSYA_ADI = :1';
    EXECUTE IMMEDIATE V_SQL USING P_DOSYA;
    EXECUTE IMMEDIATE 'DELETE FROM TEL.CDR_YUKLEME WHERE DOSYA_ADI = :1' USING P_DOSYA;
  EXCEPTION
    WHEN OTHERS THEN
      HATA_PKG.KAYDET('CDR');
      RAISE;
  END YUKLE;

  PROCEDURE OZETLE(P_DONEM IN VARCHAR2) IS
  BEGIN
    EXECUTE IMMEDIATE 'DELETE FROM TEL.CDR_OZET WHERE DONEM = :1' USING P_DONEM;
    EXECUTE IMMEDIATE
      'INSERT INTO TEL.CDR_OZET (ABONE_ID, DONEM, TOPLAM_SN, TOPLAM_UCRET) '
      || 'SELECT H.ABONE_ID, :1, SUM(C.SURE_SN), SUM(C.UCRET) FROM TEL.CDR_' || P_DONEM || ' C '
      || 'JOIN TEL.HAT H ON H.MSISDN = C.MSISDN GROUP BY H.ABONE_ID'
      USING P_DONEM;
  END OZETLE;
END CDR_PKG;
/
