CREATE OR REPLACE EDITIONABLE PACKAGE BODY "TEL"."TARIFE_PKG" AS
  FUNCTION AKTIF_MI(P_TARIFE_ID IN NUMBER) RETURN CHAR IS
    V CHAR(1);
  BEGIN
    SELECT AKTIF_MI INTO V FROM TEL.TARIFE WHERE TARIFE_ID = P_TARIFE_ID;
    RETURN V;
  END AKTIF_MI;

  -- geçerli fiyat dönemi: tarihten önceki en son başlangıç
  FUNCTION FIYAT_SATIRI(P_TARIFE_ID IN NUMBER, P_TARIH IN DATE) RETURN TEL.TARIFE_FIYAT%ROWTYPE IS
    R TEL.TARIFE_FIYAT%ROWTYPE;
  BEGIN
    SELECT * INTO R FROM (
      SELECT * FROM TEL.TARIFE_FIYAT
       WHERE TARIFE_ID = P_TARIFE_ID AND GECERLILIK_BAS <= P_TARIH
       ORDER BY GECERLILIK_BAS DESC)
     WHERE ROWNUM = 1;
    RETURN R;
  END FIYAT_SATIRI;

  FUNCTION AYLIK_UCRET(P_TARIFE_ID IN NUMBER, P_TARIH IN DATE) RETURN NUMBER IS
  BEGIN
    RETURN FIYAT_SATIRI(P_TARIFE_ID, P_TARIH).AYLIK_UCRET;
  END AYLIK_UCRET;

  FUNCTION DAKIKA_UCRET(P_TARIFE_ID IN NUMBER, P_TARIH IN DATE) RETURN NUMBER IS
  BEGIN
    RETURN FIYAT_SATIRI(P_TARIFE_ID, P_TARIH).DAKIKA_UCRET;
  END DAKIKA_UCRET;
END TARIFE_PKG;
/
