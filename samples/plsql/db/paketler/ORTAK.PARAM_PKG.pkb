CREATE OR REPLACE EDITIONABLE PACKAGE BODY "ORTAK"."PARAM_PKG" AS
  TYPE T_ONBELLEK IS TABLE OF VARCHAR2(400) INDEX BY VARCHAR2(60);
  G_ONBELLEK T_ONBELLEK;
  CURSOR C_PARAMLAR IS SELECT PARAM_KOD, PARAM_DEGER FROM ORTAK.PARAMETRE;

  PROCEDURE YENILE IS
  BEGIN
    G_ONBELLEK.DELETE;
    FOR R IN C_PARAMLAR LOOP
      G_ONBELLEK(R.PARAM_KOD) := R.PARAM_DEGER;
    END LOOP;
  END YENILE;

  FUNCTION DEGER(P_KOD IN VARCHAR2) RETURN VARCHAR2 IS
  BEGIN
    IF NOT G_ONBELLEK.EXISTS(P_KOD) THEN
      HATA_PKG.FIRLAT('PARAM', 'Tanımsız parametre: ' || P_KOD);
    END IF;
    RETURN G_ONBELLEK(P_KOD);
  END DEGER;

  FUNCTION SAYI(P_KOD IN VARCHAR2) RETURN NUMBER IS
  BEGIN
    RETURN TO_NUMBER(DEGER(P_KOD));
  END SAYI;
BEGIN
  -- paket ilk kullanıldığında önbellek dolar
  YENILE;
END PARAM_PKG;
/
