CREATE OR REPLACE EDITIONABLE PACKAGE "TEL"."ABONE_PKG" AS
  FUNCTION YENI_ABONE(P_MUSTERI_ID IN NUMBER, P_TARIFE_ID IN NUMBER) RETURN NUMBER;
  PROCEDURE DURUM_DEGISTIR(P_ABONE_ID IN NUMBER, P_DURUM IN CHAR);
  FUNCTION BUL(P_MSISDN IN VARCHAR2) RETURN NUMBER;
  PROCEDURE KAPAT(P_ABONE_ID IN NUMBER);
END ABONE_PKG;
/
