CREATE OR REPLACE EDITIONABLE PACKAGE BODY "TEL"."BILDIRIM_PKG" AS
  PROCEDURE KUYRUGA_EKLE(P_ABONE_ID IN NUMBER, P_KANAL IN VARCHAR2, P_METIN IN VARCHAR2) IS
  BEGIN
    INSERT INTO TEL.BILDIRIM_KUYRUK (BILDIRIM_ID, ABONE_ID, KANAL, METIN, DURUM)
    VALUES (TEL.SEQ_BILDIRIM.NEXTVAL, P_ABONE_ID, P_KANAL, P_METIN, 'B');
  END KUYRUGA_EKLE;

  PROCEDURE GONDER IS
    V_YANIT VARCHAR2(4000);
  BEGIN
    FOR B IN (SELECT BILDIRIM_ID, METIN FROM TEL.BILDIRIM_KUYRUK WHERE DURUM = 'B' FOR UPDATE) LOOP
      V_YANIT := UTL_HTTP.REQUEST(ORTAK.PARAM_PKG.DEGER('SMS_SERVIS_URL') || '?m=' || UTL_URL.ESCAPE(B.METIN));
      UPDATE TEL.BILDIRIM_KUYRUK SET DURUM = 'G' WHERE BILDIRIM_ID = B.BILDIRIM_ID;
    END LOOP;
  END GONDER;

  PROCEDURE SERVIS_CAGIR(P_ISLEM IN VARCHAR2, P_ID IN NUMBER) IS
    V_YANIT VARCHAR2(4000);
  BEGIN
    V_YANIT := UTL_HTTP.REQUEST(ORTAK.PARAM_PKG.DEGER('NUMARA_TASIMA_URL') || '/' || P_ISLEM || '/' || P_ID);
    LOG_PKG.YAZ('BILDIRIM', P_ISLEM || ' yanıt: ' || SUBSTR(V_YANIT, 1, 200));
  END SERVIS_CAGIR;
END BILDIRIM_PKG;
/
