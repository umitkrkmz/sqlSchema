CREATE OR REPLACE EDITIONABLE PACKAGE BODY "TEL"."KAMPANYA_PKG" AS
  FUNCTION INDIRIM(P_ABONE_ID IN NUMBER, P_DONEM IN VARCHAR2) RETURN NUMBER IS
    V_ORAN NUMBER := 0;
  BEGIN
    SELECT NVL(MAX(K.INDIRIM_ORANI), 0) INTO V_ORAN
      FROM TEL.KAMPANYA K, TEL.KAMPANYA_KATILIM KK
     WHERE KK.KAMPANYA_ID = K.KAMPANYA_ID
       AND KK.ABONE_ID = P_ABONE_ID
       AND ORTAK.TARIH_PKG.AY_BASI(P_DONEM) BETWEEN K.BAS_TAR AND NVL(K.BIT_TAR, SYSDATE);
    RETURN V_ORAN;
  END INDIRIM;

  PROCEDURE KATIL(P_ABONE_ID IN NUMBER, P_KAMPANYA_ID IN NUMBER) IS
  BEGIN
    MERGE INTO TEL.KAMPANYA_KATILIM T
    USING (SELECT P_ABONE_ID ABONE_ID, P_KAMPANYA_ID KAMPANYA_ID FROM DUAL) S
       ON (T.ABONE_ID = S.ABONE_ID AND T.KAMPANYA_ID = S.KAMPANYA_ID)
     WHEN NOT MATCHED THEN INSERT (KAMPANYA_ID, ABONE_ID, KATILIM_TAR) VALUES (S.KAMPANYA_ID, S.ABONE_ID, SYSDATE);
    LOG_PKG.YAZ('KAMPANYA', P_ABONE_ID || ' katıldı: ' || P_KAMPANYA_ID);
  END KATIL;
END KAMPANYA_PKG;
/
